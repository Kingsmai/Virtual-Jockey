{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VJ Modular Strobe Engine",
  "version": "1.0.0",
  "identifier": "com.vjmodular.strobe",
  "build": {
    "beforeDevCommand": "npm run build",
    "devUrl": "http://localhost:20023",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VJ MASTER CONSOLE - MODULAR PLUGIN MATRIX",
        "url": "index.html",
        "width": 1400,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
